{
  "name": "@hideoo/prettier-config",
  "version": "2.0.1",
  "license": "MIT",
  "description": "HiDeoo's Prettier configuration",
  "author": "HiDeoo <github@hideoo.dev> (https://hideoo.dev)",
  "main": ".prettierrc.json",
  "scripts": {
    "lint": "prettier -c --cache .",
    "format": "prettier -w --cache .",
    "version": "pnpm changeset version && pnpm i --no-frozen-lockfile"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.2",
    "prettier": "3.9.6"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=24",
      "onFail": "download"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "12.3.4",
      "onFail": "download"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "files": [
    ".prettierrc.json"
  ],
  "keywords": [
    "prettier",
    "config",
    "prettier-config"
  ],
  "homepage": "https://github.com/HiDeoo/prettier-config",
  "repository": {
    "type": "git",
    "url": "https://github.com/HiDeoo/prettier-config.git"
  },
  "bugs": "https://github.com/HiDeoo/prettier-config/issues"
}
